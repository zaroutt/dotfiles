           {
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/cachyos.txt",
    "color": {
      "1": "yellow",
      "2": "green",
      "3": "bright_green",
      "4": "white",
      "5": "white",
      "6": "white",
      "7": "white",
      "8": "white",
      "9": "white",
    },
    "padding": {
      "top": 2,
      "left": 1,
      "right": 1,
      "bottom": 1,
    },
  },

  "display": { "separator": " " },
  "modules": [
    { "key": " ", "type": "custom" },
    { "key": " ", "type": "custom" },
    { "key": "  user", "type": "title", "format": "{user-name}", "keyColor": "yellow" },
    { "key": "󰅐  uptime", "type": "uptime", "keyColor": "red" },
    { "key": "  distro", "type": "os", "keyColor": "green" },
    { "key": "  kernel", "type": "kernel", "keyColor": "cyan" },
    { "key": "  wm", "type": "wm", "keyColor": "blue" },
    {
      "key": "  term",
      "type": "terminal",
      "format": "Kitty",
      "keyColor": "magenta",
    },
    { "key": "  shell", "type": "shell", "keyColor": "yellow" },
    { "key": "󰍛  cpu", "type": "cpu", "showPeCoreCount": true, "keyColor": "red" },
    {
      "key": "󰉉  disk",
      "type": "disk",
      //"folders": "/",
      "format": "{1} / {2} ({3})",
      "keyColor": "green",
    },
    { "key": "  memory", "type": "memory", "keyColor": "cyan" },
    { "key": "󰏖  pkgs", "type": "packages", "keyColor": "blue" },
    { "key": " ", "type": "custom" },
    { "key": " ", "type": "custom" },
  ],
}
